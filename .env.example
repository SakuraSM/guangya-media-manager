# 镜像版本；latest 会跟随最新稳定版，也可固定为 v0.1.4 等版本标签。
IMAGE_TAG=latest

# Web 监听地址。仅本机访问保持 127.0.0.1；NAS 局域网访问改为 NAS 内网 IP。
BIND_HOST=127.0.0.1
WEB_ORIGIN=http://127.0.0.1:4173

# 首次可在演示模式体验；连接真实云盘前请修改密码和密钥并设为 false。
APP_ENV=development
DEMO_MODE=true
ADMIN_PASSWORD=change-me
SESSION_SECRET=replace-with-a-random-32-character-secret
TOKEN_ENCRYPTION_KEY=

# 光鸭 API 保护。默认值适合个人 NAS，通常无需修改；账号出现频控时可适当调大。
GUANGYA_API_READ_INTERVAL_SECONDS=0.35
GUANGYA_API_WRITE_INTERVAL_SECONDS=1.2
GUANGYA_API_POLL_INTERVAL_SECONDS=1.0
GUANGYA_API_JITTER_SECONDS=0.2
GUANGYA_API_MAX_RETRIES=3
GUANGYA_API_BACKOFF_BASE_SECONDS=2
GUANGYA_API_BACKOFF_MAX_SECONDS=30

# TMDB 必填；代理仅在 NAS 无法直连 TMDB 时填写。
TMDB_API_TOKEN=
TMDB_PROXY_URL=

# AI 为可选兜底识别能力。
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
